APP_NAME="Portal Escolar de Asistencia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santo_Domingo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Para TrueNAS PostgreSQL use pgsql y un esquema aislado:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=attendance
# DB_USERNAME=attendance_app
# DB_PASSWORD=
# DB_SEARCH_PATH=attendance_app,public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lectores biométricos ZKTeco (variables consumidas por scripts/biometrico.py)
# La IP es opcional: cada lector se identifica por MAC y se redescubre si DHCP la cambia.
# Para varios lectores, use un arreglo JSON en una sola línea. Ejemplo:
# BIOMETRIC_READERS=[{"key":"escuela-1-entrada","name":"Entrada principal","school":"Escuela 1","mac":"00:17:61:11:18:e3","network":"192.168.100"},{"key":"escuela-1-salida","name":"Salida","school":"Escuela 1","mac":"00:11:22:33:44:55","network":"192.168.100"}]
BIOMETRIC_READERS=
# Compatibilidad para una instalación con un solo lector:
BIOMETRIC_DEFAULT_SCHOOL_CODE=INST001
BIOMETRIC_DEFAULT_SCHOOL_NAME="Centro Educativo INST001"
BIOMETRIC_READER_KEY=lector-1
BIOMETRIC_READER_NAME=Lector principal
BIOMETRIC_READER_SCHOOL=
BIOMETRIC_READER_IP=
BIOMETRIC_READER_NETWORK=192.168.100
BIOMETRIC_READER_MAC=00:17:61:11:18:e3
BIOMETRIC_READER_PORT=4370
BIOMETRIC_READER_PASSWORD=0
BIOMETRIC_READER_TIMEOUT=5
BIOMETRIC_RECONNECT_DELAY=10
BIOMETRIC_DELAYED_AFTER_MINUTES=2
BIOMETRIC_OFFLINE_AFTER_MINUTES=10
BIOMETRIC_ATTENDANCE_URL=http://127.0.0.1:8000/api/asistencia
BIOMETRIC_API_TOKEN=
BIOMETRIC_LOG_FILE=storage/logs/biometric.log

# Solo para la primera siembra. Use claves largas y quite estos valores después.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@asistencia.test
INITIAL_ADMIN_PASSWORD=
INITIAL_TEACHER_USERNAME=docente
INITIAL_TEACHER_EMAIL=docente@asistencia.test
INITIAL_TEACHER_PASSWORD=
