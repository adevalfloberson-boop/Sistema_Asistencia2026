APP_NAME="Portal Escolar de Asistencia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Para lectores ADMS, incluye el puerto público del listener: https://dominio:2080
APP_URL=http://localhost:2080
SERVER_PORT=2080
APP_TIMEZONE=America/Santo_Domingo

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_PROHIBIT_DESTRUCTIVE_COMMANDS=true
# Para TrueNAS PostgreSQL use pgsql y un esquema aislado:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=attendance
# DB_USERNAME=attendance_app
# DB_PASSWORD=
# DB_SEARCH_PATH=attendance_app,public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lectores biométricos ZKTeco por ADMS.
# Cada lector se descubre automáticamente con su número de serie al contactar
# APP_URL/iclock/cdata. Los lectores nuevos quedan pendientes de asignar a una escuela.
BIOMETRIC_DELAYED_AFTER_MINUTES=2
BIOMETRIC_OFFLINE_AFTER_MINUTES=10
BIOMETRIC_API_TOKEN=

# Solo para la primera siembra. Use una clave larga y quite estos valores después.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@asistencia.test
INITIAL_ADMIN_PASSWORD=
