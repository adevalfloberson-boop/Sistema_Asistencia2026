APP_NAME="Portal Escolar de Asistencia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://asistencia.asodomae.org
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Hestia debe alcanzar PostgreSQL en TrueNAS por la red privada de Tailscale.
DB_CONNECTION=pgsql
DB_HOST=TRUENAS_TAILSCALE_IP_OR_NAME
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=attendance_app
DB_PASSWORD=
DB_SEARCH_PATH=attendance_app,public
DB_SSLMODE=prefer
DB_PROHIBIT_DESTRUCTIVE_COMMANDS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=asistencia.asodomae.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

BIOMETRIC_DELAYED_AFTER_MINUTES=2
BIOMETRIC_OFFLINE_AFTER_MINUTES=10
BIOMETRIC_API_TOKEN=

# Use estos valores una sola vez y luego elimine la contraseña del .env.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@asistencia.asodomae.org
INITIAL_ADMIN_PASSWORD=
