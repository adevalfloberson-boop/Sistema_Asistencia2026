APP_NAME="Portal Escolar de Asistencia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL alojado en TrueNAS y accesible por Tailscale.
DB_CONNECTION=pgsql
DB_HOST=TRUENAS_TAILSCALE_IP_OR_NAME
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=attendance_app
DB_PASSWORD=
DB_SEARCH_PATH=attendance_app,public
DB_SSLMODE=prefer
DB_PROHIBIT_DESTRUCTIVE_COMMANDS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

BIOMETRIC_DELAYED_AFTER_MINUTES=2
BIOMETRIC_OFFLINE_AFTER_MINUTES=10
BIOMETRIC_API_TOKEN=

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@asistencia.test
INITIAL_ADMIN_PASSWORD=
